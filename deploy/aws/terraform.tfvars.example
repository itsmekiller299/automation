# Copy to terraform.tfvars and fill in. Never commit real secrets.

aws_region  = "us-east-1"
project     = "orbit"
environment = "production"

# Set after the first targeted apply that creates the ECR repositories,
# or pass with -var on the command line.
api_image       = "123456789012.dkr.ecr.us-east-1.amazonaws.com/orbit-api:v1"
dashboard_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/orbit-dashboard:v1"

# HTTPS is required for Meta webhooks in production. Request/validate an ACM
# certificate for your domain first, then put its ARN here.
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"
public_base_url = "https://support.example.com"

# Meta
app_secret   = "replace-with-meta-app-secret"
verify_token = "replace-with-a-long-random-verify-token"
phone_number_id                = "1234567890"
whatsapp_business_account_id   = "1234567890"
whatsapp_template_name         = "agent_handoff"
whatsapp_template_language     = "en_US"
ig_business_account_id         = "17890000000000000"

# Leave empty to generate the dashboard key into Secrets Manager.
admin_api_key = ""

# Provider choices
llm_provider = "anthropic"
llm_model    = "claude-sonnet-4-5"
llm_api_key  = "" # empty => safe template fallback

# Optional integrations
orders_api_url    = ""
smtp_host         = ""
smtp_username     = ""
smtp_from         = ""
handoff_email_to  = ""
slack_webhook_url = ""

# Sizing
api_desired_count    = 2
api_min_count        = 2
api_max_count        = 6
worker_desired_count = 1
db_instance_class    = "db.t4g.medium"
redis_node_type      = "cache.t4g.micro"

# For a throwaway environment only:
# db_deletion_protection = false
# db_skip_final_snapshot = true
