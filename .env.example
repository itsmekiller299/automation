# ─────────────────────────────────────────────────────────────────────────────
# Orbit / Aurora Living assistant — copy to .env and fill real values.
#   cp .env.example .env
# Never commit .env or real Meta/SMTP credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- app ---
APP_NAME=Orbit Auto-Reply
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
DASHBOARD_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
# Set to a long random value to protect dashboard/API routes. Leave blank for local-only.
ADMIN_API_KEY=
BRAND_NAME=Aurora Living
DATA_RETENTION_DAYS=180

# --- storage ---
# Host development default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite:///./data/app.db
REDIS_URL=redis://localhost:6379/0
# `inline` is easiest for local dev/tests. Docker Compose forces `celery`.
QUEUE_BACKEND=inline
CELERY_TASK_ALWAYS_EAGER=false
SESSION_TTL_SECONDS=86400

# --- Meta webhooks / Graph API ---
# Required to verify X-Hub-Signature-256 in production.
APP_SECRET=replace-with-your-meta-app-secret
VERIFY_TOKEN=replace-with-a-long-random-verify-token
# Local demos only. Set false in production; unsigned webhooks are rejected.
ALLOW_UNSIGNED_WEBHOOKS=true
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=agent_handoff
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WINDOW_HOURS=24
IG_PAGE_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
IG_API_VERSION=v21.0
GRAPH_BASE_URL=https://graph.facebook.com
INSTAGRAM_WINDOW_HOURS=24

# --- customer portal (multi-tenant SaaS) ---
PORTAL_ENABLED=true
PORTAL_PUBLIC_URL=http://localhost:5173
# Encrypts stored channel access tokens. Use a long random value in production.
# Falls back to APP_SECRET only for local development.
PORTAL_ENCRYPTION_KEY=
PORTAL_SESSION_HOURS=12
PORTAL_LOGIN_MAX_ATTEMPTS=10
PORTAL_LOGIN_WINDOW_SECONDS=600
PORTAL_PASSWORD_MIN_LENGTH=10
# Local/demo only; ignored when ENVIRONMENT=production.
PORTAL_ALLOW_MOCK_CHANNEL_CONNECT=true
# Meta app used for OAuth / Embedded Signup when connecting real channels.
PORTAL_META_APP_ID=
PORTAL_META_APP_SECRET=
PORTAL_META_CONFIG_ID=
PORTAL_OAUTH_REDIRECT_URI=http://localhost:5173/portal
# These templates must be approved in Meta before proactive messages send.
PORTAL_WELCOME_TEMPLATE_NAME=portal_login_confirmation
PORTAL_WELCOME_TEMPLATE_LANGUAGE=en_US
PORTAL_ASSIGNMENT_TEMPLATE_NAME=agent_assigned
PORTAL_ASSIGNMENT_TEMPLATE_LANGUAGE=en_US
# `dev` returns the OTP in local API responses. Use `webhook` in production and
# point PORTAL_OTP_WEBHOOK_URL at your SMS/WhatsApp gateway. `disabled` turns it off.
PORTAL_OTP_DELIVERY=dev
PORTAL_OTP_WEBHOOK_URL=
PORTAL_OTP_TTL_SECONDS=600
PORTAL_OTP_MAX_ATTEMPTS=5

# --- NLU ---
# auto = ONNX -> Torch checkpoint -> deterministic rules fallback.
NLU_BACKEND=auto
NLU_MODEL_DIR=ml/artifacts/intent-model
NLU_ONNX_PATH=ml/artifacts/intent-model/model.onnx
NLU_MODEL_VERSION=rules-v1
NLU_EVALUATION_PATH=ml/artifacts/evaluation/evaluation.json
INTENT_CONFIDENCE_THRESHOLD=0.80
MAX_FALLBACKS=2
MAX_WINDOW_ATTEMPTS=2

# --- RAG ---
# auto = sentence-transformers + FAISS when installed, lexical fallback otherwise.
RAG_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_LOCAL_ONLY=true
FAQ_PATH=ml/data/faqs.jsonl
RAG_TOP_K=3
RAG_MIN_SCORE=0.12
RAG_MIN_SEMANTIC_SCORE=0.38

# --- optional LLM ---
# template = grounded template responses only (default). none = disable rewriting.
# anthropic = rewrite verified answers with Claude; ungrounded output is discarded.
LLM_PROVIDER=template
LLM_API_KEY=
# Verify the current model ID in the Anthropic console before deploying.
LLM_MODEL=claude-sonnet-4-5
LLM_BASE_URL=https://api.anthropic.com
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_TIMEOUT_SECONDS=12.0
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.2

# --- orders ---
# Point at your real internal order service in production.
ORDERS_API_URL=
ORDERS_API_TOKEN=
ORDERS_TIMEOUT_SECONDS=5.0
ORDERS_FIXTURE_PATH=ml/data/orders.json
ENABLE_MOCK_ORDERS_API=true

# --- notifications ---
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
HANDOFF_EMAIL_TO=

# --- outbound ---
# auto = real sender when credentials exist, mock otherwise. mock = never call Meta.
OUTBOUND_MODE=auto
SENDER_TIMEOUT_SECONDS=10
SENDER_MAX_RETRIES=3

# --- docker compose ---
POSTGRES_PASSWORD=orbit
DASHBOARD_PORT=3000
# True installs torch/transformers/FAISS into the API image (large, slow build).
INSTALL_ML=false
# True installs onnxruntime + tokenizer only (serves model.onnx without torch).
INSTALL_ONNX=false
# Required for `docker compose --profile tunnel up`.
NGROK_AUTHTOKEN=
